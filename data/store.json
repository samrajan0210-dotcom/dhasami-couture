        "desc": "Every ensemble is verified for artisanal weaving and genuine natural materials."
      },
      {
        "title": "Direct From Weavers",
        "desc": "Fair compensation and artisan guild welfare directly supported through every patronage."
      },
      {
        "title": "Bespoke Fit",
        "desc": "In-house master tailors provide customized falls, borders, and blouse measurements prior to sealing."
      }
    ]
